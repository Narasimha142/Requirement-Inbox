{
  "manifest_version": 3,
  "name": "Requirement Inbox",
  "short_name": "Req Inbox",
  "version": "1.6.0",
  "description": "Pulls job requirements from Gmail, Dice, job boards and startup job posts, filters them to your profile, lets you reply to many at once with your resume attached, and tracks replies and applications.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Requirement Inbox",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.dice.com/*",
    "https://hn.algolia.com/*"
  ],
  "oauth2": {
    "client_id": "827439252524-kkqtt64meqnlv3r17nij38s67l9vdvvp.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.compose"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.dice.com/*"
      ],
      "js": [
        "dice-content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
